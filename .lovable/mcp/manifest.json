    "tools": [
      {
        "name": "whoami",
        "title": "Identidade do usuário conectado",
        "description": "Retorna o perfil e o papel (admin, collaborator, client) do usuário do SC Central autenticado nesta sessão MCP.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_clients",
        "title": "Listar clientes",
        "description": "Lista os clientes visíveis ao usuário autenticado, respeitando as políticas de acesso do SC Central.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Máximo de clientes a retornar.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "default": 0,
              "description": "Deslocamento para paginação.",
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "search": {
              "description": "Busca por razão social (opcional).",
              "type": "string",
              "maxLength": 120
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_processes",
