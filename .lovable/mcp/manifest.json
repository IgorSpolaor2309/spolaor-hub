{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ifrixutgtmopfshhendy.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "sc-central-mcp",
      "version": "0.1.0",
      "title": "SC Central"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Identidade do usuário conectado",
        "description": "Retorna o perfil e o papel (admin, collaborator, client) do usuário do SC Central autenticado nesta sessão MCP.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_clients",
        "title": "Listar clientes",
        "description": "Lista os clientes visíveis ao usuário autenticado, respeitando as políticas de acesso do SC Central.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Máximo de clientes a retornar.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "default": 0,
              "description": "Deslocamento para paginação.",
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "search": {
              "description": "Busca por razão social (opcional).",
              "type": "string",
              "maxLength": 120
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_processes",
        "title": "Listar processos",
        "description": "Lista os processos (company_processes) visíveis ao usuário autenticado, respeitando as políticas de acesso do SC Central.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Máximo de processos a retornar.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "default": 0,
              "description": "Deslocamento para paginação.",
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "status": {
              "description": "Filtrar por status (opcional).",
              "type": "string",
              "maxLength": 40
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_pending_tasks",
        "title": "Listar pendências",
        "description": "Lista as pendências (pending_tasks) visíveis ao usuário autenticado, respeitando as políticas de acesso do SC Central.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Máximo de pendências a retornar.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "default": 0,
              "description": "Deslocamento para paginação.",
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        "outputSchema": null
      }
