          "type": "object",
          "properties": {
            "client_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "UUID da empresa (client_id)."
            }
          },
          "required": [
            "client_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_process_details",
        "title": "Detalhes do processo",
        "description": "Retorna os detalhes de um processo (company_processes) visível ao usuário autenticado, respeitando as políticas do SC Central. Cliente vê apenas informações liberadas no portal (visivel_cliente).",
